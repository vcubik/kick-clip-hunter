# Credentials from your Kick app at https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Optional: credentials of a Twitch application (https://dev.twitch.tv/console),
# for watching Twitch channels. Leave empty to watch Kick only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: where Kick sends the browser back to when the account the bot
# writes in Kick's chat as signs in from the dashboard. The Kick app has to
# have exactly this as its redirect URL. Left empty it is
# http://localhost:8000/bot/kick/signed_in - only the host and the port are
# yours to change, the path stays /bot/kick/signed_in.
KICK_REDIRECT_URI=
