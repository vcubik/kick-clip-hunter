# Credentials from your Kick app at https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Optional: credentials of a Twitch application (https://dev.twitch.tv/console),
# for watching Twitch channels. Leave empty to watch Kick only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: where Kick sends the browser back to when the account the bot
# writes in Kick's chat as signs in from the dashboard. The Kick app has to
# have exactly this as its redirect URL. Left empty it is
# http://localhost:8000/bot/kick/signed_in - only the host and the port are
# yours to change, the path stays /bot/kick/signed_in.
KICK_REDIRECT_URI=

# Optional: a key of Euler Stream's (https://www.eulerstream.com), the service
# that signs the requests TikTok's chat is read with while a TikTok stream is
# recorded. Without one it signs a few thousand a day - plenty for a few
# channels.
EULER_STREAM_API_KEY=

# Optional: where notifications go - of clips, of recordings of whole streams,
# of anything the Health page says needs a look (see notify.py). Either, both
# or neither.
# A Telegram bot made with @BotFather (its token), and the chat it writes in:
# write to the bot, then `PYTHONPATH=src python scripts/telegram_chats.py`
# lists the chats it can write in, with their ids.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a Bot API server of your own (github.com/tdlib/telegram-bot-api,
# run with --local), e.g. http://localhost:8081 - it takes videos of up to
# 2000 MB instead of 50 MB. Left empty, Telegram's own is asked.
TELEGRAM_API_URL=
# A Discord channel's webhook (the channel's settings, Integrations, Webhooks,
# Copy Webhook URL).
DISCORD_WEBHOOK_URL=

# Optional: where the dashboard is reached from, for the links in
# notifications - from a phone on the tailnet, e.g.
# http://<machine>.<tailnet>.ts.net:8000. Without it they have none.
DASHBOARD_URL=
